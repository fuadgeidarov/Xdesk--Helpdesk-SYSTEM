# ============================================
# Xdesk public configuration template
# Copy this file to .env and replace placeholders.
# NEVER commit the real .env file.
# ============================================

# PostgreSQL
POSTGRES_USER=xdesk
POSTGRES_PASSWORD=CHANGE_ME_STRONG_DATABASE_PASSWORD
POSTGRES_DB=xdesk

# Application authentication secret (32+ random characters recommended)
AUTH_SECRET=CHANGE_ME_LONG_RANDOM_SECRET_AT_LEAST_32_CHARS

# Public URL of your portal.
# Local HTTP example: http://localhost
# Public IP example: https://203.0.113.10
# Domain example: https://support.example.com
APP_URL=http://localhost
COOKIE_SECURE=false
TRUST_PROXY=true

# Public host used by the optional Nginx/Certbot HTTPS helper.
# Enter ONLY the IP address or hostname, without http://, https:// or a port.
PUBLIC_HOST=localhost
TLS_CERT_NAME=localhost

# Runtime/database tuning
SESSION_TTL_HOURS=24
DB_CONNECTION_LIMIT=20
DB_POOL_TIMEOUT=20
DB_TRANSACTION_MAX_WAIT_MS=10000
DB_TRANSACTION_TIMEOUT_MS=15000
DB_STARTUP_CHECK=true
UPLOAD_DIR=

# Optional demo/test accounts. Disabled by default.
# If enabled, provide passwords of at least 12 characters.
SEED_DEFAULT_USERS=false
SEED_ADMIN_EMAIL=admin@xdesk.local
SEED_AGENT_EMAIL=agent@xdesk.local
SEED_USER_EMAIL=user@xdesk.local
SEED_ADMIN_PASSWORD=
SEED_AGENT_PASSWORD=
SEED_USER_PASSWORD=

# Destructive test reset guard. Keep false for normal use.
XDESK_ALLOW_TEST_RESET=false

# Used only if running the application outside docker-compose.
DATABASE_URL="postgresql://xdesk:CHANGE_ME_STRONG_DATABASE_PASSWORD@localhost:5432/xdesk?schema=public&connection_limit=20&pool_timeout=20&connect_timeout=10"

# Optional password-recovery SMTP
# Provider preset: gmail | mailru | custom
SMTP_PROVIDER=custom
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_ALLOW_ANONYMOUS=false
SMTP_TLS_REJECT_UNAUTHORIZED=true

# Optional Telegram bot integration (Long Polling; no webhook required)
TELEGRAM_BOT_ENABLED=false
TELEGRAM_BOT_TOKEN=
BOT_COMPANY_NAME=Xdesk
