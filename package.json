{
  "name": "xdesk",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:setup": "prisma db push && tsx prisma/seed.ts",
    "postinstall": "prisma generate",
    "db:check": "tsx scripts/db-check.ts",
    "db:stress": "tsx scripts/db-stress.ts",
    "db:reset-test": "tsx scripts/reset-test-db.ts",
    "typecheck": "tsc --noEmit",
    "security:audit": "npm audit --omit=dev"
  },
  "dependencies": {
    "@prisma/client": "6.5.0",
    "bcryptjs": "3.0.3",
    "jose": "6.2.9",
    "next": "15.5.23",
    "react": "19.0.8",
    "react-dom": "19.0.8",
    "zod": "3.25.76",
    "nodemailer": "9.0.3"
  },
  "devDependencies": {
    "@types/node": "22.13.10",
    "@types/react": "19.0.12",
    "@types/react-dom": "19.0.4",
    "prisma": "6.5.0",
    "tsx": "4.19.3",
    "typescript": "5.8.2"
  },
  "packageManager": "npm@10.9.2",
  "overrides": {
    "postcss": "8.5.26",
    "sharp": "0.35.3"
  }
}
